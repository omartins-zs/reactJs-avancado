APP_NAME="ReactJS Avancado DIO"
APP_ENV=local
APP_DEBUG=true
REACT_APP_NAME="ReactJS Avancado DIO"
NODE_OPTIONS=--openssl-legacy-provider

# ==============================================================================
# MODO DE EXECUÇÃO (Alternar comentando/descomentando o bloco desejado)
# ==============================================================================

# --- LOCAL (Padrão: Laragon / Execução Direta) ---
APP_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000
PORT=3000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=reactjs_avancado
DB_USERNAME=root
DB_PASSWORD=

# --- DOCKER (Descomente para usar no Docker e comente o bloco LOCAL acima) ---
# APP_URL=http://localhost:8080
# REACT_APP_API_URL=http://localhost:8080
# PORT=3000
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=reactjs_avancado
# DB_USERNAME=root
# DB_PASSWORD=root
